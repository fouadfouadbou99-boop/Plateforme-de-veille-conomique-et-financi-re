import feedparser

RSS_URL = "https://blogs.worldbank.org/feed"


def get_worldbank_documents():

    docs = []

    try:

        feed = feedparser.parse(
            RSS_URL
        )

        for entry in feed.entries:

            docs.append(
                {
                    "Source": "Banque Mondiale",
                    "Titre": entry.get(
                        "title",
                        ""
                    ),
                    "Date": entry.get(
                        "published",
                        ""
                    ),
                    "Lien": entry.get(
                        "link",
                        ""
                    ),
                    "PDF": ""
                }
            )

        print(
            f"WORLDBANK: {len(docs)} documents"
        )

        return docs

    except Exception as e:

        print(
            f"WORLDBANK ERROR: {e}"
        )

        return []
